#include<bits/stdc++.h>
const int MOD = 1e9+7;
using namespace std;

vector<int> f(1e6+5,0);
long long n;
void dp(long long l){
    for(int i=1;i<=n;i++){
        for(int j=1;j<=6&&i-j>=0;j++){
            f[i]=((f[i]+f[i-j]) % MOD);
        }
    }
}
int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
//    freopen("bai2.inp","r",stdin);
//    freopen("bai2.out","w",stdout);
    cin>>n;
    f[0]=1;
    dp(n);
    cout<<f[n];
    return 0;
}
