#include<bits/stdc++.h>

using namespace std;

vector<int> adj[1000005];
vector<bool> visited(1000005,0);
void dfs(int u){
    visited[u]=1;
    for(int v:adj[u]){
        if(!visited[v]){
            dfs(v);
        }
    }
}
int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    freopen("ketban.inp","r",stdin);
    freopen("ketban.out","w",stdout);
    int n,m,k;
    cin>>n>>k>>m;
    for(int i=0;i<m;i++){
        int x,y;
        cin>>x>>y;
        adj[x].push_back(y);
        adj[y].push_back(x);
    }
    dfs(k);
    int d=0;
    for(int i=1;i<=n;i++){
        if((visited[i]==1)&&(i!=k)){
            d++;
        }
    }
    cout<<d;
    return 0;
}
