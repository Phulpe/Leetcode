#include <bits/stdc++.h>
#define ll long long
using namespace std;

int main(){
    ios_base::sync_with_stdio(false);
    cout.tie(NULL);
    cin.tie(NULL);
    freopen("nangluc.INP","r",stdin);
    freopen("nangluc.OUT","w",stdout);
    int n,k;
    vector<ll> c(100005);
    vector<ll> a(100005);
    ll sum=0;
    cin>>n>>k;
    for(int i=1;i<=n;i++){
        cin>>a[i];
        sum+=a[i];
    }
    long long res=-1e9;
    if(sum<k){
        cout<<-1;
    }else{
        c[1]=a[1];
        c[0]=0;
        for(int i=2;i<=n;i++){
            c[i]=a[i]+c[i-1];
        }
        for(int i=1;i<n;i++){
            for(int j=i+1;j<=n;j++){
                long long total=c[j]-c[i-1];
                if(total>=k){
                    res=max(total/(j-i+1),res);
                    break;
                }
            }
        }

    }
    cout<<res;

    return 0;
}
