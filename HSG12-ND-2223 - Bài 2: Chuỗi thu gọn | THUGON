    freopen("THUGON.inp","r",stdin);
    freopen("THUGON.out","w",stdout);

    while(cin>>s){
        //cin>>s;
        cin.ignore();
        int d=0;
        char last=s[0];
        for(int i=1;i<=s.length();i++){
            if(s[i]==last){
