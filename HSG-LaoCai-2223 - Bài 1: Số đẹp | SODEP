#include <bits/stdc++.h>

using ll = unsigned long long;
using namespace std;

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    freopen("sodep.inp","r",stdin);
    freopen("sodep.out","w",stdout);
    string k,s;
    while(cin>>k){
        s+=k;
    }
    ll n = stol(s);
    int d=0;
    for(ll i=1;i<=sqrt(n);i++){
        if((n%i==0)&&(i!=n/i)){
            d+=2;
        }else
        if((n%i==0)&&(i==n/i)){
            d++;
        }
    }
    cout<<d;
    return 0;
}
