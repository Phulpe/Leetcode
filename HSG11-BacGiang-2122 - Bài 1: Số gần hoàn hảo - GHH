#include<bits/stdc++.h>
#define ll long long

using namespace std;

ll n,x;
vector<ll> si(2000005,0);
vector<ll> a(2000005);
void sieve(ll m){
    for(ll i=1;i*2<=m;i++){
        for(ll j=2;i*j<=m;j++){
            si[i*j]+=i;
        }
    }
}
int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    freopen("ghh.inp","r",stdin);
    freopen("ghh.out","w",stdout);

    cin>>n;
    sieve(1000005);
    for(ll i=1;i<=n;i++){
        cin>>x;
        if(2*x<=si[x]+x)
            cout<<1<<"\n";
        else
            cout<<0<<"\n";
    }

    return 0;
}
