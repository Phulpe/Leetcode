#include <bits/stdc++.h>
#define ll long long
#define endl "\n"

using namespace std;

vector<ll>a,b;
map<int,int>mp;
ll n,m,s,d=0;
bool bs(int aim){
    int l=0;
    int r=b.size();
    while(l<=r){
        int mid=(l+r)/2;
        if(b[mid]==aim){
//            cout<<aim<<endl;
            return 1;
        }else{
            if(b[mid]<aim){
                l=mid+1;
            }else{
                r=mid-1;
            }
        }
    }
    return 0;
}
int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
     freopen("SUMX.inp", "r", stdin);
     freopen("SUMX.out", "w", stdout);

    cin>>n>>m>>s;
    for(int i=0;i<n;i++){
        ll x;
        cin>>x;
        a.push_back(x);
    }
    for(int i=0;i<m;i++){
        ll x;
        cin>>x;
        mp[x]++;
        b.push_back(x);
    }
    sort(a.begin(),a.end());
    sort(b.begin(),b.end());
    for(int i=0;i<n;i++){
        ll tmp=s-a[i];
//        cout<<a[i]<<" ";
        bool check=bs(tmp);
        if(check==1){
            d+=mp[tmp];
//            cout<<a[i]<<" "<<tmp<<" "<<d<<endl;
        }

    }
    cout<<d;
    return 0;
}
