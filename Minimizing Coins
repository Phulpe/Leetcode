#include<bits/stdc++.h>
const int MOD = 1e9+7;
using namespace std;

vector<vector<int> > f(105,vector<int>(1e6+5,INT_MAX));
vector<int> a(105);
long long n,x;
void dp(){
    for(int i=1;i<=n;i++){
        for(long long j=1;j<=x;j++){
            if(j-a[i]>=0)
                f[i][j]=min(f[i-1][j],f[i][j-a[i]]+1)%MOD;
                else
                f[i][j]=f[i-1][j]%MOD;
        }
    }
}
int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
//    freopen("bai2.inp","r",stdin);
//    freopen("bai2.out","w",stdout);
    cin>>n>>x;
    for(int i=1;i<=n;i++)
            cin>>a[i];
    for(int i=0;i<=n;i++){
        f[i][0]=0;
    }
    dp();
    if(f[n][x]==INT_MAX)cout<<-1; else cout<<f[n][x];
    return 0;
}
