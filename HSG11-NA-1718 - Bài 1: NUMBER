#include <bits/stdc++.h>
#define ll long long
using namespace std;

int n;
vector<int> a(100005);
vector<bool> f(100005,1);
void sieve(ll n){
    f[0]=f[1]=0;
    for(ll i=2;i*i<=n;i++){
        if(f[i]){
            for(ll j=i*i;j<=n;j+=i){
                f[j]=0;
            }
        }
    }
}
int main(){
    ios_base::sync_with_stdio(false);
    cout.tie(NULL);
    cin.tie(NULL);
    freopen("number.INP","r",stdin);
    freopen("number.OUT","w",stdout);
    n=0;
    while(cin>>a[n]){
            n++;
    }
    sieve(100000);
    for(int i=n-2;i>0;i--){
        if((a[i-1]<=0)||(a[i+1]<=0))
                continue;
        if((f[a[i-1]])&&(f[a[i+1]])){
            cout<<i+1;
            return 0;
        }

    }
    cout<<0;
    return 0;
}
