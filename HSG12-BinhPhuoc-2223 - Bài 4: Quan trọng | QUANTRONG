#include <bits/stdc++.h>

using namespace std;

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    freopen("quantrong.inp","r",stdin);
    freopen("quantrong.out","w",stdout);
    long long n,MAX=INT_MIN;
    cin>>n;
    vector<long long> b(5*1e5+5,0),a(5*1e5+5,0),c(1005,0),d(1005,0);
    for(int i=1;i<=n;i++){
        cin>>a[i];
        if(d[a[i]]==0)
            d[a[i]]=i;
        else
            c[a[i]]=i;
        b[i]=b[i-1]+a[i];
        MAX=max(MAX,a[i]);
    }
    long long kq=INT_MIN;
    for(int i=1;i<=MAX;i++){
        if((d[i]!=0)&&(c[i]!=0)){
            kq=max(b[c[i]]-b[d[i]-1],kq);
        }
    }
    cout<<kq;

    return 0;
}
